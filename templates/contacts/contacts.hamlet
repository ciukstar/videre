
^{widgetMainMenu idOverlay idDialogMainMenu}

<header.fixed.primary>
  <nav.responsive.max>
    <button.circle.transparent data-ui=##{idDialogMainMenu}>
      <i>menu

    <h1.title.max>
      _{MsgContacts}

    ^{widgetAccount}

<main.responsive.no-padding>

  $if null entries
    <figure.margin.center-align>
      <i.extra.margin>folder_open
        
      <figcaption>
        <p>_{MsgYourContactListIsEmpty}
        
        <p.secondary-text>
          _{MsgYouMightWantToAddAFew}

        $with backlink <- rndr $ MyContactsR uid
          <a.button.large href=@?{(ContactsR uid,[("backlink",backlink)])} role=button>
            <i>add
            _{MsgAdd}
          
  $else
    
    $forall (Entity cid _,(Entity rid (User email _ _ _ _ name _ _),((attrib,(ns,(nl,na))),content))) <- entries
      <a.row.padding.wave href=@{ChatR $ ChatRoomR uid cid rid}>

        <div ##{idUserAvatar}#{rid}>
          <img.circle src=@{AccountPhotoR rid} alt=_{MsgPhoto} loading=lazy>

          $if ns < 1
            <i.absolute.tiny.circle.tiny-padding.error.#{classBadgeRtcStatus} ##{idBadgeRtcStatus}#{rid}>
              notifications_off
          $elseif nl > 0
            <i.absolute.tiny.circle.tiny-padding.error.#{classBadgeRtcStatus} ##{idBadgeRtcStatus}#{rid}>
              repeat
          $elseif na < 1
            <i.absolute.tiny.circle.tiny-padding.error.#{classBadgeRtcStatus} ##{idBadgeRtcStatus}#{rid}>
              phone_disabled


          $case M.lookup rid online
            $of Just (Just _lastSeen)
              <div.#{classStatus}.badge.bottom.left.grey ##{idBadgeOnline}#{rid}>
            $of Just Nothing
              <div.#{classStatus}.badge.bottom.left.green ##{idBadgeOnline}#{rid}>
            $of Nothing
              
                          

        <div.#{classContactLines}.max ##{idContactLines}#{rid}>
          <div.row.#{classHeadline}.large-text>
            <div.max>
              $maybe name <- name
                #{name}
              $nothing
                #{email}

            $maybe (time, (_, (_, (_, (_, _))))) <- content
              $with dt <- iso8601Show time
                <time.#{classLastSeenTime}.secondary-text.small-text datetime=#{dt}>#{dt}

          $maybe (_, (message, (ctype, (media, (delivered, read))))) <- content
            <div.#{classSupportingText}.secondary-text.small-text.no-padding.no-margin ##{idLastMessage}#{rid}>
              $if media
                $case ctype
                  $of CallTypeVideo
                    <i.small>videocam
                    _{MsgVideoCall}
                  $of CallTypeAudio
                    <i.small>call
                    _{MsgAudioCall}
              $else
                $if read
                  <i.small.green-text>
                    done_all
                $elseif delivered
                  <i.small>
                    done_all
                $else
                  <i.small>
                    check
      
                #{message}

          $nothing
            $case M.lookup rid online
              $of Just (Just lastSeen)
                <div.#{classSupportingText}.small-text.secondary-text ##{idStatusLine}#{rid}>
                  <span.lower>_{MsgLastSeenAt} #
                  $with dt <- show lastSeen
                    <time.#{classLastSeenTime} datetime=#{dt}>#{dt}

              $of Just Nothing
                <div.#{classSupportingText}.lower.small-text.green-text ##{idStatusLine}#{rid}>
                  _{MsgOnline}

              $of Nothing


        <i.secondary-text>arrow_forward_ios
 
      $maybe attrib <- attrib
        <div.app-attribution>
          <div.app-attribution-wrapper>
            #{attrib}

      <hr>

    $with backlink <- rndr $ MyContactsR uid
      <a.button.circle.extra.fixed.right.bottom.margin.medium-elevate title=_{MsgAdd}
                         href=@?{(ContactsR uid,[("backlink",backlink)])} role=button>
        <i>add

^{widgetSnackbar msgs}
