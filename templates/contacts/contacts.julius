

Array.from(
  document.body.querySelectorAll('time.#{rawJS classLastSeenTime}[datetime]')
).forEach(function (x) {
  x.textContent = ctxtimefmt(new Date(x.getAttribute('datetime')));
});


navigator.serviceWorker.addEventListener('message', function (message) {

  if (message.data.messageType === #{PushMsgTypeSubscribed}) {
    
    document.getElementById(`#{rawJS idBadgeRtcStatus}${message.data.senderId}`)?.remove();
    
  } else if (message.data.messageType === #{PushMsgTypeUnsubscribed}) {
    
    document.getElementById(`#{rawJS idBadgeRtcStatus}${message.data.senderId}`)?.remove();
    
  }

});

const channel = new WebSocket('@{OnlineChannelR uid}');

channel.onmessage = debounce (function (e) {
  
  const data = JSON.parse(e.data);

  if (data.type === #{WsMessageTypeOnline}) {

    const badge = document.getElementById(`#{rawJS idBadgeOnline}${data.user}`);
    if (badge) {
      badge.replaceWith((() => {
        const newBadge = document.createElement('div');
        newBadge.id = `#{rawJS idBadgeOnline}${data.user}`;
        newBadge.classList.add(#{classStatus},'badge','bottom','left','green');
        return newBadge;
      }) ());
    } else {
      const avatar = document.getElementById(`#{rawJS idUserAvatar}${data.user}`);
      if (avatar) {
        avatar.appendChild((() => {
          const newBadge = document.createElement('div');
          newBadge.id = `#{rawJS idBadgeOnline}${data.user}`;
          newBadge.classList.add(#{classStatus},'badge','bottom','left','green');
          return newBadge;        
        }) ());
      }
    }

    const messageLine = document.getElementById(`#{rawJS idLastMessage}${data.user}`);

    if (!messageLine) {
      const statusLine = document.getElementById(`#{rawJS idStatusLine}${data.user}`);
      if (statusLine) {
        statusLine.classList.add(#{classSupportingText},'lower','small-text','green-text');
        statusLine.textContent = #{msgr MsgOnline};
      } else {
        const contactContent = document.getElementById(`#{rawJS idContactLines}${data.user}`);
        if (contactContent) {
          contactContent.appendChild((() => {
            const line = document.createElement('div');
            line.id = `#{rawJS idStatusLine}${data.user}`;
            line.classList.add(#{classSupportingText},'lower','small-text','green-text');
            line.textContent = #{msgr MsgOnline};
            return line;
          }) ());
        }
      }
    }
    
  } else if (data.type === #{WsMessageTypeOffline}) {

    const badge = document.getElementById(`#{rawJS idBadgeOnline}${data.user}`);
    if (badge) {
      badge.replaceWith((() => {
        const newBadge = document.createElement('div');
        newBadge.id = `#{rawJS idBadgeOnline}${data.user}`;
        newBadge.classList.add(#{classStatus},'badge','bottom','left','grey4');
        return newBadge;
      }) ());
    } else {
      const avatar = document.getElementById(`#{rawJS idUserAvatar}${data.user}`);
      if (avatar) {
        avatar.appendChild((() => {
          const newBadge = document.createElement('div');
          newBadge.id = `#{rawJS idBadgeOnline}${data.user}`;
          newBadge.classList.add(#{classStatus},'badge','bottom','left','grey4');
          return newBadge;        
        }) ());
      }
    }

    const messageLine = document.getElementById(`#{rawJS idLastMessage}${data.user}`);

    if (!messageLine) {

      const statusLine = document.getElementById(`#{rawJS idStatusLine}${data.user}`);
    
      if (statusLine) {
        
        statusLine.replaceWith((() => {
          const newStatusLine = document.createElement('div');
          newStatusLine.id = `#{rawJS idStatusLine}${data.user}`;
          newStatusLine.classList.add(#{classSupportingText},'small-text','secondary-text');
          
          newStatusLine.appendChild((() => {
            const span = document.createElement('span');
            span.classList.add('lower');
            span.textContent = `#{rawJS $ msgr MsgLastSeenAt} `;
            return span;
          }) ());
          
          newStatusLine.appendChild((() => {
            const lastSeen = document.createElement('time');
            lastSeen.classList.add(#{classLastSeenTime});
            lastSeen.setAttribute('datetime', data.lastSeen);
            lastSeen.textContent = ctxtimefmt(new Date(lastSeen.getAttribute('datetime')));
            return lastSeen;
          }) ());
          
          return newStatusLine;
        }) ());
        
      } else {
        
        const contactContent = document.getElementById(`#{rawJS idContactLines}${data.user}`);
        
        if (contactContent) {
          contactContent.appendChild((() => { 
            
            const line = document.createElement('div');
            line.id = `#{rawJS idStatusLine}${data.user}`;
            line.classList.add(#{classSupportingText},'small-text','secondary-text');
            
            line.appendChild((() => {
              const span = document.createElement('span');
              span.classList.add('lower');
              span.textContent = `#{rawJS $ msgr MsgLastSeenAt} `;
              return span;
            }) ());
            
            line.appendChild((() => {
              const lastSeen = document.createElement('time');
              lastSeen.classList.add(#{classLastSeenTime});
              lastSeen.setAttribute('datetime', data.lastSeen);
              lastSeen.textContent = ctxtimefmt(new Date(lastSeen.getAttribute('datetime')));              
              return lastSeen;
            }) ());
            
            return line;
          }) ());
        }
      }
    }
    
  }
  
}, 2000);
