
^{widgetMainMenu idOverlay idDialogMainMenu}

<header.fixed.primary>
  <nav.responsive.max>
    <button.circle.transparent data-ui=##{idDialogMainMenu}>
      <i>menu

    <h1.title.max>
      _{MsgTokens}

    ^{widgetAccount}

<main.responsive.no-padding>
  
  <div.tabs.min>
    <a href=@{DataR TokenGmailR}>
      Gmail
    
    <a.active href=@{DataR TokenVapidR}>
      VAPID

  <div.page.active.padding>

    $maybe _ <- token
      <article>
        <h2.title>
          VAPID

        <p.secondary-text>
          _{MsgVapidGenerationWarning}.

        <p>

          <form.formStoreType method=post action=@{DataR TokenVapidR} enctype=#{et} ##{idForm}>
            ^{fw}

        <nav>
          <form method=post action=@{DataR TokensVapidClearR} enctype=#{et0} ##{idFormClear}>
            ^{fw0}

          <button.transparent.link type=submit form=#{idFormClear}>
            _{MsgClearSettings}

          <button type=submit form=#{idForm}>
            _{MsgGenerate}
        
    $nothing
      <p.center-align.large-text>
        <i>warning
        _{MsgVapidNotGenerated}
        
      <details.top-margin>
        <summary.button.responsive.transparent.border>
          <i>expand_more
          _{MsgGenerateNewVapid}

        <form.formStoreType method=post action=@{DataR TokenVapidR} enctype=#{et} ##{idForm}>
          ^{fw}

          <nav.right-align>
            <button type=submit>
              _{MsgGenerate}


^{widgetSnackbar msgs}
