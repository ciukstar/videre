
<div.overlay ##{idOverlay}>

<dialog.left.primary ##{idDialogMainMenu}>

  <header.fixed.max>
    <nav.margin>
      <img.large src=@{StaticR img_logo_primary_svg} loading=lazy alt=_{MsgLogo}>
      <h6.max>
        _{MsgAppName}
      <button.transparent.circle.large ##{idButtonMainMenuClose} data-ui=##{idDialogMainMenu}>
        <i>close

  <ol.list>

    <li.wave.round :curr == Just HomeR:.active>
      <a href=@{HomeR}>
        <i>home
        <span>_{MsgHome}

    $maybe Entity uid _ <- user
      <li.wave.round :curr == Just (MyContactsR uid):.active>
        <a href=@{MyContactsR uid}>
          <i>contacts
          <span>_{MsgContacts}

      <li.wave.round :curr == Just (CallsR uid):.active>
        <a href=@{CallsR uid}>
          <i.no-round>call_log
          <span>_{MsgCalls}

  $maybe Entity _ (User _ _ _ _ _ _ super admin) <- user
    $if super || admin
      <hr.top-margin>
      <div.small-text>
        _{MsgData}
        

      <ol.list>
        <li.wave.round :curr == Just (DataR UsersR):.active>
          <a href=@{DataR UsersR}>
            <i>group
            <span>_{MsgUsers}
        
        <li.wave.round :curr == Just (DataR SubscriptionsR):.active>
          <a href=@{DataR SubscriptionsR}>
            <i>circle_notifications
            <span>_{MsgSubscriptions}
        
        <li.wave.round :curr == Just (DataR RingtonesR):.active>
          <a href=@{DataR RingtonesR}>
            <i>ring_volume
            <span>_{MsgRingtones}
        
        <li.wave.round :curr == Just (DataR TokenGmailR):.active :curr == Just (DataR TokenVapidR):.active>
          <a href=@{DataR TokenGmailR}>
            <i>token
            <span>_{MsgTokens}

  <hr.top-margin>
  <div.small-text>
    _{MsgResources}
        
       
  <ol.list>
    <li.wave.round :curr == Just DocsR:.active>
      <a href=@{DocsR}>
        <i>quick_reference
        <span>_{MsgDocumentation}

    <li.wave.round>
      <a href="https://github.com/ciukstar/videre" target=_blank>
        <i>code
        <span>_{MsgSourceCode}
